# Copy to .env.local and fill in real values. .env.local is gitignored.

# Google Analytics 4 Measurement ID (G-XXXXXXXXXX).
# Leave empty to disable analytics in this environment.
NEXT_PUBLIC_GA_ID=

# Supabase project — powers the /event page (check-in, task submissions, feedback).
# The publishable key is safe to expose to the browser; access is gated by
# insert-only Row Level Security policies (see supabase/event-setup.sql).
# NEXT_PUBLIC_* vars are inlined at build time, so they must be set when running
# `next build` (locally and in the Docker build args). If unset, the /event page
# degrades gracefully and shows a "backend not configured" notice.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
